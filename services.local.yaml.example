# Copy to services.local.yaml (gitignored, personal): same shape as services.yaml, a field set
# here wins over services.yaml for that service.
#
# Listing a service here (even with nothing under it) makes it part of the default SERVICES:
# `make run` alone clones and starts all of them.
#   with branch:    clone / checkout use that branch
#   without branch: leave it on whatever branch it is (a fresh clone: the default branch)
#
# api_keys: real keys of the services calling this one (a key per caller, from whoever is authorized
# to give it, never committed), a caller listed by its `keys:` in services.yaml. `make secrets`
# (and `make up`) write each key to both sides: the caller's env var and API_CLIENT_<CALLER>_KEY here.
# A new key: python3 -c 'import secrets; print(secrets.token_hex(32))'

example:
  branch: main
  # api_keys:
  #   cms: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
