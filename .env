COMPOSE_PROJECT_NAME=laba_traefik
# The aliases file is generated from services.yaml by `make gen` (make traefik-up runs it).
COMPOSE_FILE=docker-compose.yml:generated/compose.aliases.yml

# Host ports.
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080
REDIS_PORT=6379
RABBITMQ_PORT=5672

# The message broker (laba_rabbitmq) in development; set others in the environment for anything but development.
RABBITMQ_USER=laba
RABBITMQ_PASSWORD=laba
