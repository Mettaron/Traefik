#!/usr/bin/env python3
"""Fills a service's own .env.local with the real inter-service API keys it declares in `keys:`
(env var -> peer), taking each peer's `api_key:` from services.local.yaml (gitignored: real
values are never committed; whoever fills it in gets them from wherever they are authorized to).

A key not yet in services.local.yaml is skipped with a warning, never written empty. Generated
lines live in one marked block, so re-running is idempotent; a line written by hand outside the
block is left alone. Only variable names are printed, never values.

Usage:
  svc-secret <service>            Update Laba/Services/<service>/.env.local.
  svc-secret --changed <service>  After rotating <service>'s api_key: update every service whose
                                  `keys:` points at it (its real consumers only).
"""
import re
import sys

import registry

MARKER = "# --- inter-service API keys (Traefik/bin/svc-secret): re-run it instead of editing this block ---"


def hand_written(service: str) -> set[str]:
    """Variables set in .env.local outside the generated block: never overwritten."""
    env_local = registry.SERVICES_DIR / service / ".env.local"
    names: set[str] = set()
    for line in env_local.read_text().splitlines() if env_local.exists() else []:
        if line.strip() == MARKER:
            break
        if m := re.match(r"^([A-Za-z_][A-Za-z0-9_]*)=", line):
            names.add(m.group(1))
    return names


def upsert_env_local(service: str, values: dict[str, str]) -> None:
    env_local = registry.SERVICES_DIR / service / ".env.local"
    lines = env_local.read_text().splitlines() if env_local.exists() else []
    remaining = dict(values)
    out: list[str] = []

    for line in lines:
        if line.strip() == MARKER:
            break  # the generated block is always last: rebuilt below
        m = re.match(r"^([A-Za-z_][A-Za-z0-9_]*)=", line)
        if m:
            remaining.pop(m.group(1), None)  # set by hand: keep it
        out.append(line)

    while out and out[-1] == "":
        out.pop()

    if remaining:
        out += ([""] if out else []) + [MARKER] + [f"{k}={remaining[k]}" for k in sorted(remaining)]

    env_local.write_text("\n".join(out) + "\n")


def process(service: str) -> bool:
    """False: the service declares no keys."""
    wanted = registry.keys(service)
    if not wanted:
        return False
    if not (registry.SERVICES_DIR / service).is_dir():
        print(f"{service}: not cloned in {registry.SERVICES_DIR}, skipped", file=sys.stderr)
        return True

    by_hand = hand_written(service)
    resolved = {var: registry.field(peer, "api_key") for var, peer in wanted.items() if var not in by_hand}
    missing = sorted(f"{var} ({wanted[var]}: api_key: ... in services.local.yaml)" for var, value in resolved.items() if not value)
    resolved = {var: value for var, value in resolved.items() if value}

    if resolved:
        upsert_env_local(service, resolved)
        print(f"{service}: .env.local <- {', '.join(sorted(resolved))}")
    if missing:
        print(f"{service}: skipped, not in services.local.yaml yet: {', '.join(missing)}", file=sys.stderr)
    return True


def changed(peer: str) -> int:
    consumers = [s for s in registry.services() if s != peer and peer in registry.keys(s).values()]
    if not consumers:
        print(f"{peer}: no service's `keys:` points at it, nothing to refresh")
        return 0
    for consumer in consumers:
        process(consumer)
    print(f"{peer}: refreshed {len(consumers)} consumer(s): {', '.join(consumers)}")
    return 0


def main(args: list[str]) -> int:
    match args:
        case ["--changed", peer]:
            return changed(peer)
        case [service] if not service.startswith("--"):
            if not process(service):
                print(f"{service}: no `keys:` in services.yaml, nothing to do")
            return 0
        case _:
            print(__doc__, file=sys.stderr)
            return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
