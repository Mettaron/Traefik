#!/usr/bin/env python3
"""Fills a service's own .env.local with the real inter-service API keys: a key per pair of services
(caller -> called), from the called service's `api_keys:` in services.local.yaml (gitignored: real
values are never committed; whoever fills it in gets them from wherever they are authorized to).
Both sides of a pair get the same key:

  outbound  the caller declares `keys: {USERS_API_KEY: users}` in services.yaml: it gets
            USERS_API_KEY = users.api_keys.<caller> (laba/client-bundle sends it);
  inbound   the called service gets API_CLIENT_<CALLER>_KEY with the same value, what its
            laba_service.api_access.clients.<caller>.key reads ('%env(API_CLIENT_CMS_KEY)%').

A key not yet in services.local.yaml is skipped with a warning, never written empty. Generated
lines live in one marked block, so re-running is idempotent; a line written by hand outside the
block is left alone. Only variable names are printed, never values.

Usage:
  svc-secret <service>            Update Laba/Services/<service>/.env.local: its outbound and inbound keys.
  svc-secret --changed <service>  After changing <service>'s api_keys: update it and every service
                                  whose `keys:` calls it.
"""
import re
import sys

import registry

MARKER = "# --- inter-service API keys (Traefik/bin/svc-secret): re-run it instead of editing this block ---"


def hand_written(service: str) -> set[str]:
    """Variables set in .env.local outside the generated block: never overwritten."""
    env_local = registry.SERVICES_DIR / service / ".env.local"
    names: set[str] = set()
    for line in env_local.read_text().splitlines() if env_local.exists() else []:
        if line.strip() == MARKER:
            break
        if m := re.match(r"^([A-Za-z_][A-Za-z0-9_]*)=", line):
            names.add(m.group(1))
    return names


def upsert_env_local(service: str, values: dict[str, str]) -> None:
    env_local = registry.SERVICES_DIR / service / ".env.local"
    lines = env_local.read_text().splitlines() if env_local.exists() else []
    remaining = dict(values)
    out: list[str] = []

    for line in lines:
        if line.strip() == MARKER:
            break  # the generated block is always last: rebuilt below
        m = re.match(r"^([A-Za-z_][A-Za-z0-9_]*)=", line)
        if m:
            remaining.pop(m.group(1), None)  # set by hand: keep it
        out.append(line)

    while out and out[-1] == "":
        out.pop()

    if remaining:
        out += ([""] if out else []) + [MARKER] + [f"{k}={remaining[k]}" for k in sorted(remaining)]

    env_local.write_text("\n".join(out) + "\n")


def wanted(service: str) -> dict[str, tuple[str, str]]:
    """Env var -> (called service, caller) of every pair the service is in, either side."""
    pairs = {var: (peer, service) for var, peer in registry.keys(service).items()}
    pairs |= {registry.inbound_var(caller): (service, caller) for caller in registry.consumers(service)}
    return pairs


def process(service: str) -> bool:
    """False: the service is in no pair (it calls no one and no one calls it)."""
    pairs = wanted(service)
    if not pairs:
        return False
    if not (registry.SERVICES_DIR / service).is_dir():
        print(f"{service}: not cloned in {registry.SERVICES_DIR}, skipped", file=sys.stderr)
        return True

    by_hand = hand_written(service)
    resolved = {var: registry.api_keys(called).get(caller, "") for var, (called, caller) in pairs.items() if var not in by_hand}
    missing = sorted(
        f"{var} ({pairs[var][0]}: api_keys: {pairs[var][1]}: ... in services.local.yaml)"
        for var, value in resolved.items() if not value
    )
    resolved = {var: value for var, value in resolved.items() if value}

    if resolved:
        upsert_env_local(service, resolved)
        print(f"{service}: .env.local <- {', '.join(sorted(resolved))}")
    if missing:
        print(f"{service}: skipped, not in services.local.yaml yet: {', '.join(missing)}", file=sys.stderr)
    return True


def changed(peer: str) -> int:
    consumers = registry.consumers(peer)
    if not consumers:
        print(f"{peer}: no service's `keys:` points at it, nothing to refresh")
        return 0
    for service in [peer, *consumers]:
        process(service)
    print(f"{peer}: refreshed it and {len(consumers)} caller(s): {', '.join(consumers)}")
    return 0


def main(args: list[str]) -> int:
    match args:
        case ["--changed", peer]:
            return changed(peer)
        case [service] if not service.startswith("--"):
            if not process(service):
                print(f"{service}: calls no service and no service calls it, nothing to do")
            return 0
        case _:
            print(__doc__, file=sys.stderr)
            return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
