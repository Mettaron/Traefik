#!/usr/bin/env python3
"""Generates the Traefik config that depends on the registry (run by `make traefik-up` / `make gen`):

- generated/compose.aliases.yml: <service>.localhost and <service>.local network aliases of
  laba_traefik, so a container can reach another service through Traefik by its host
  (and hit the staging fallback when that service is not running locally);
- dynamic/fallback-<service>.yml for every service with a staging_origin: low-priority routers
  sending both hosts to stage; a locally running service (priority 99) wins over them.

Both are gitignored: services.yaml stays the only place a service is described.
"""
import sys

import registry

ALIASES = registry.ROOT / "generated" / "compose.aliases.yml"
DYNAMIC = registry.ROOT / "dynamic"
HEADER = "# Generated by bin/gen-traefik from services.yaml: do not edit, run `make gen` instead.\n"


def aliases() -> str:
    hosts = [host for s in registry.services() for host in (registry.local_host(s), registry.internal_host(s))]
    lines = "".join(f"          - {host}\n" for host in hosts)

    return HEADER + (
        "services:\n"
        "  laba_traefik:\n"
        "    networks:\n"
        "      laba_network:\n"
        "        aliases:\n" + (lines or "          []\n")
    )


def fallback(service: str, origin: str) -> str:
    return HEADER + f"""http:
  routers:
    {service}-fallback:
      rule: "Host(`{registry.local_host(service)}`) || Host(`{registry.internal_host(service)}`)"
      service: {service}-fallback
      priority: 1
  services:
    {service}-fallback:
      loadBalancer:
        passHostHeader: false
        servers:
          - url: "{origin}"
"""


def main() -> int:
    ALIASES.parent.mkdir(exist_ok=True)
    ALIASES.write_text(aliases())

    for old in DYNAMIC.glob("fallback-*.yml"):
        old.unlink()

    fallbacks = []
    for service in registry.services():
        origin = registry.field(service, "staging_origin")
        if origin:
            (DYNAMIC / f"fallback-{service}.yml").write_text(fallback(service, origin))
            fallbacks.append(service)

    print(f"traefik: {len(registry.services())} service(s) aliased, staging fallback for: {', '.join(fallbacks) or 'none'}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
